{
  "entities": {
    "LabActivity": {
      "title": "LabActivity",
      "description": "A web-based ICT Laboratory assessment or deployed web simulation session for BS Marine Transportation students.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Short lab identifier such as LAB-01",
          "minLength": 2,
          "maxLength": 24
        },
        "title": {
          "type": "string",
          "description": "Laboratory activity or web simulation title",
          "minLength": 3,
          "maxLength": 120
        },
        "topic": {
          "type": "string",
          "description": "Topic or module focus",
          "minLength": 2,
          "maxLength": 80
        },
        "sessionDate": {
          "type": "string",
          "description": "Scheduled session date (YYYY-MM-DD)",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "status": {
          "type": "string",
          "description": "Visibility status of the laboratory activity",
          "enum": ["active", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the activity was created"
        }
      },
      "required": ["code", "title", "topic", "sessionDate", "status", "createdAt"]
    },
    "Evaluation": {
      "title": "Evaluation",
      "description": "Student evaluation and post-session feedback (anonymous by default, or with student name/email if explicitly allowed).",
      "type": "object",
      "properties": {
        "activityId": {
          "type": "string",
          "description": "Document ID of the evaluated LabActivity",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "activityTitle": {
          "type": "string",
          "description": "Snapshot title of the evaluated activity",
          "minLength": 1,
          "maxLength": 120
        },
        "activityRating": {
          "type": "integer",
          "description": "Rating (1-5) for web-based lab assessment / simulation effectiveness"
        },
        "classRating": {
          "type": "integer",
          "description": "Rating (1-5) for overall class experience"
        },
        "teachingRating": {
          "type": "integer",
          "description": "Rating (1-5) for teaching effectiveness"
        },
        "feedback": {
          "type": "string",
          "description": "Post-session comment or feedback",
          "minLength": 0,
          "maxLength": 1500
        },
        "section": {
          "type": "string",
          "description": "BSMT class section label",
          "minLength": 1,
          "maxLength": 40
        },
        "sessionDate": {
          "type": "string",
          "description": "Session date (YYYY-MM-DD)",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "isAnonymous": {
          "type": "boolean",
          "description": "True when the student chose an anonymous profile"
        },
        "studentName": {
          "type": "string",
          "description": "Student display name (empty string when anonymous)",
          "minLength": 0,
          "maxLength": 120
        },
        "studentEmail": {
          "type": "string",
          "description": "Verified @hcdc.edu.ph email (empty string when anonymous)",
          "minLength": 0,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the evaluation was submitted"
        }
      },
      "required": [
        "activityId",
        "activityTitle",
        "activityRating",
        "classRating",
        "teachingRating",
        "feedback",
        "section",
        "sessionDate",
        "isAnonymous",
        "studentName",
        "studentEmail",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/lab_activities/{activityId}": {
      "schema": { "$ref": "#/entities/LabActivity" },
      "description": "Collection of BS Marine Transportation ICT Laboratory sessions/activities."
    },
    "/evaluations/{evaluationId}": {
      "schema": { "$ref": "#/entities/Evaluation" },
      "description": "Student session ratings and post-session feedback records."
    }
  }
}
